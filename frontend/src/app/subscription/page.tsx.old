"use client"

import { useState } from "react"
import { Metadata } from "next"
import { useSubscription } from "@/features/subscription/hooks/useSubscription"
import { LoadingSkeleton, ErrorMessage } from "@/features/subscription/components/loading-skeleton"
import { openStripeCustomerPortal } from "@/shared/lib/payments"
import { useAuthStore } from "@/features/auth/stores"

export default function SubscriptionPage() {
  const { data, loading, error, refetch } = useSubscription()
  const [isPortalLoading, setIsPortalLoading] = useState(false)
  const user = useAuthStore((s) => s.user)
  const token = useAuthStore((s) => s.token)

  const handleManageSubscription = async () => {
    if (!token) return
    
    try {
      setIsPortalLoading(true)
      await openStripeCustomerPortal(token)
    } catch (err) {
      console.error("Failed to open portal:", err)
      alert("Не удалось открыть портал управления подпиской")
    } finally {
      setIsPortalLoading(false)
    }
  }

  // Show "Manage" button only if user has stripe_customer_id
  const hasStripeSubscription = user?.plan && user.plan !== "free"

  if (loading) {
    return (
      <div className="container mx-auto py-10 px-4 max-w-7xl">
        <div className="mb-8">
          <h1 className="text-3xl font-bold mb-2">Подписка</h1>
          <p className="text-muted-foreground">
            Управление вашим тарифом и использованием кредитов
          </p>
        </div>
        <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <div className="md:col-span-2 lg:col-span-3">
            <LoadingSkeleton />
          </div>
        </div>
      </div>
    )
  }

  if (error) {
    return (
      <div className="container mx-auto py-10 px-4 max-w-7xl">
        <div className="mb-8">
          <h1 className="text-3xl font-bold mb-2">Подписка</h1>
          <p className="text-muted-foreground">
            Управление вашим тарифом и использованием кредитов
          </p>
        </div>
        <ErrorMessage error={error} onRetry={refetch} />
      </div>
    )
  }

  if (!data) {
    return null
  }

  const { plan, usage, subscription } = data

  return (
    <div className="container mx-auto py-10 px-4 max-w-7xl">
      <div className="mb-8">
        <h1 className="text-3xl font-bold mb-2">Подписка</h1>
        <p className="text-muted-foreground">
          Управление вашим тарифом и использованием кредитов
        </p>
      </div>

      <div className="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {/* Current Plan */}
        <div className="md:col-span-2 lg:col-span-3">
          <div className="rounded-lg border bg-card p-6">
            <div className="flex items-center justify-between mb-4">
              <div>
                <h2 className="text-2xl font-bold">{plan.name.toUpperCase()}</h2>
                <p className="text-sm text-muted-foreground">
                  Текущий тариф
                  {subscription.status === "active" && subscription.renewalDate && (
                    <> • Продление: {new Date(subscription.renewalDate).toLocaleDateString("ru-RU")}</>
                  )}
                </p>
              </div>
              <div className="flex gap-2">
                {hasStripeSubscription && (
                  <button
                    onClick={handleManageSubscription}
                    disabled={isPortalLoading}
                    className="px-4 py-2 border border-primary text-primary rounded-md hover:bg-primary hover:text-primary-foreground disabled:opacity-50"
                  >
                    {isPortalLoading ? "Загрузка..." : "Управление"}
                  </button>
                )}
                <button className="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">
                  Обновить план
                </button>
              </div>
            </div>
            <div className="grid gap-4 md:grid-cols-2">
              <div>
                <p className="text-sm text-muted-foreground mb-1">Кредиты</p>
                <p className="text-2xl font-bold">
                  {usage.creditsRemaining} / {plan.creditsPerMonth}
                </p>
              </div>
              <div>
                <p className="text-sm text-muted-foreground mb-1">Проекты</p>
                <p className="text-2xl font-bold">
                  {usage.projectsUsed} / {plan.projectLimit ?? "∞"}
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Pricing Plans */}
        <div className="md:col-span-2 lg:col-span-3">
          <h2 className="text-xl font-bold mb-4">Доступные тарифы</h2>
          <div className="grid gap-4 md:grid-cols-3">
            {/* Starter */}
            <div className="rounded-lg border bg-card p-6">
              <h3 className="text-lg font-bold mb-2">STARTER</h3>
              <p className="text-3xl font-bold mb-1">5<span className="text-sm text-muted-foreground">/мес</span></p>
              <p className="text-sm text-muted-foreground mb-4">150 кредитов/мес</p>
              <ul className="space-y-2 mb-6 text-sm">
                <li>✓ 10 проектов</li>
                <li>✓ GitHub интеграция</li>
                <li>✓ Приоритетная поддержка</li>
              </ul>
              <button className="w-full px-4 py-2 border border-primary text-primary rounded-md hover:bg-primary hover:text-primary-foreground">
                Выбрать план
              </button>
            </div>

            {/* Pro */}
            <div className="rounded-lg border-2 border-primary bg-card p-6 relative">
              <div className="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-primary text-primary-foreground text-xs font-bold rounded-full">
                ПОПУЛЯРНЫЙ
              </div>
              <h3 className="text-lg font-bold mb-2">PRO</h3>
              <p className="text-3xl font-bold mb-1">9<span className="text-sm text-muted-foreground">/мес</span></p>
              <p className="text-sm text-muted-foreground mb-4">400 кредитов/мес</p>
              <ul className="space-y-2 mb-6 text-sm">
                <li>✓ 50 проектов</li>
                <li>✓ Приоритетный деплой</li>
                <li>✓ Расширенная аналитика</li>
              </ul>
              <button className="w-full px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90">
                Выбрать план
              </button>
            </div>

            {/* Business */}
            <div className="rounded-lg border bg-card p-6">
              <h3 className="text-lg font-bold mb-2">BUSINESS</h3>
              <p className="text-3xl font-bold mb-1">49<span className="text-sm text-muted-foreground">/мес</span></p>
              <p className="text-sm text-muted-foreground mb-4">1500 кредитов/мес</p>
              <ul className="space-y-2 mb-6 text-sm">
                <li>✓ Безлимитные проекты</li>
                <li>✓ Выделенная поддержка</li>
                <li>✓ SLA гарантии</li>
              </ul>
              <button className="w-full px-4 py-2 border border-primary text-primary rounded-md hover:bg-primary hover:text-primary-foreground">
                Выбрать план
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
