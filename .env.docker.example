# ===========================================
# Docker Compose Environment Variables
# ===========================================
# Этот файл содержит переменные для docker-compose.yml
# Скопируйте его в .env (корень проекта) если хотите изменить defaults

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viably

# Примечание: Дополнительные переменные для backend и frontend
# находятся в backend/.env и frontend/.env.local соответственно
