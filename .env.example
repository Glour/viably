# =============================================================================
# Viably — Backend Environment Variables
# Скопировать в backend/.env и заполнить значения
# =============================================================================

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/viably
POSTGRES_DB=viably
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Anthropic AI ---
ANTHROPIC_API_KEY=sk-ant-api03-...
# Если используется viably-proxy:
AI_GATEWAY_KEY=gw_viably_...

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- OAuth: GitHub ---
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...

# --- Платежи: Stripe ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Платежи: YooKassa ---
YOOKASSA_SHOP_ID=...
YOOKASSA_SECRET_KEY=live_...

# --- Платежи: NOWPayments (крипта) ---
NOWPAYMENTS_API_KEY=...
NOWPAYMENTS_IPN_SECRET=...

# --- Email: Resend ---
RESEND_API_KEY=re_...

# --- Мониторинг: Sentry ---
# Оставить пустым для отключения
SENTRY_DSN=

# --- Hetzner Cloud (для auto-provision серверов) ---
HETZNER_API_TOKEN=...

# --- Приложение ---
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://viably.io
BACKEND_URL=https://viably.io

# =============================================================================
# Frontend Environment Variables (.env.local)
# =============================================================================

# NEXT_PUBLIC_API_URL=https://viably.io
# NEXT_PUBLIC_WS_URL=wss://viably.io
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# INTERNAL_API_URL=http://backend-prod:8000
# NEXT_TELEMETRY_DISABLED=1
